# Required - get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# AI providers - only the key for the provider you set in MODEL is required.
# The app will fall back through the others if the chosen one fails.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Which AI provider to try first: openrouter | groq | gemini | ollama | claude
MODEL=openrouter
